{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "electron.vite.config.ts"],
  // page.ts runs inside a web page and needs DOM types, so it is typechecked by
  // tsconfig.web.json instead — keeping DOM globals out of the main process.
  "exclude": ["src/preload/page.ts"]
}
